rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "kQJxJP5ArhXkL4uB22gh3CKrjEH3";
    }

    function hasSellerProfile(userId) {
      return exists(/databases/$(database)/documents/admins/$(userId));
    }

    function isActiveSeller(userId) {
      return hasSellerProfile(userId)
        && get(/databases/$(database)/documents/admins/$(userId)).data.active == true
        && (
          get(/databases/$(database)/documents/admins/$(userId)).data.role == "admin"
          || get(/databases/$(database)/documents/admins/$(userId)).data.role == "owner"
          || (
            get(/databases/$(database)/documents/admins/$(userId)).data.role == "dealer"
            && get(/databases/$(database)/documents/admins/$(userId)).data.approvalStatus == "approved"
          )
        );
    }

    function isActiveBuyer(userId) {
      return exists(/databases/$(database)/documents/buyers/$(userId))
        && (
          !('active' in get(/databases/$(database)/documents/buyers/$(userId)).data)
          || get(/databases/$(database)/documents/buyers/$(userId)).data.active == true
        );
    }

    function isActiveParticipant(userId) {
      return isActiveBuyer(userId) || isActiveSeller(userId);
    }

    function isPendingDealer(userId) {
      return hasSellerProfile(userId)
        && get(/databases/$(database)/documents/admins/$(userId)).data.role == "dealer"
        && get(/databases/$(database)/documents/admins/$(userId)).data.active == false
        && get(/databases/$(database)/documents/admins/$(userId)).data.approvalStatus == "pending";
    }

    match /admins/{userId} {
      allow read: if signedIn()
        && (isOwner() || request.auth.uid == userId || isActiveSeller(request.auth.uid));

      // Sellers can create only their own restricted, pending dealer profile.
      allow create: if isOwner()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'role', 'active', 'approvalStatus',
            'verificationStatus', 'sellerType', 'businessName',
            'whatsapp', 'createdAt', 'createdBy'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'email', 'role', 'active', 'approvalStatus',
            'verificationStatus', 'sellerType', 'businessName',
            'whatsapp', 'createdAt', 'createdBy'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == "dealer"
          && request.resource.data.active == false
          && request.resource.data.approvalStatus == "pending"
          && request.resource.data.verificationStatus == "pending"
          && request.resource.data.sellerType in ["dealership", "broker"]
          && request.resource.data.businessName is string
          && (request.resource.data.sellerType != "dealership" || request.resource.data.businessName.size() >= 2)
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() >= 10
          && request.resource.data.whatsapp.size() <= 15
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
        );

      // Only the owner can change approval, activity, or verification status.
      // A signed-in seller can update their own name and WhatsApp number.
      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['name', 'whatsapp', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() >= 10
          && request.resource.data.whatsapp.size() <= 15
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isOwner()
        || (signedIn() && request.auth.uid == userId);
    }

    match /buyers/{userId} {
      allow read: if signedIn()
        && (isOwner() || request.auth.uid == userId || isActiveSeller(request.auth.uid));

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'active', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'active', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && (isOwner() || request.auth.uid == userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name', 'phone', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15;

      allow delete: if isOwner()
        || (signedIn() && request.auth.uid == userId);
    }

    match /cars/{carId} {
      // Active sellers can create new vehicle listings
      allow create: if isActiveSeller(request.auth.uid)
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && request.resource.data.manufacturer is string
        && request.resource.data.manufacturer.size() >= 1
        && request.resource.data.manufacturer.size() <= 50
        && request.resource.data.carType in ["sedan", "suv", "hatchback", "coupe", "convertible", "wagon", "pickup", "van", "minivan", "other"]
        && request.resource.data.model is string
        && request.resource.data.model.size() >= 1
        && request.resource.data.model.size() <= 50
        && request.resource.data.year is int
        && request.resource.data.year >= 1990
        && request.resource.data.year <= 2030
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.status in ["Fresh Import", "Locally Used", "Brand New"]
        && (
          request.resource.data.mileage == null
          || (
            request.resource.data.mileage is int
            && request.resource.data.mileage >= 0
          )
        )
        && request.resource.data.fuel in ["petrol", "diesel", "hybrid", "electric", "plug_in_hybrid", "cng", "lpg"]
        && request.resource.data.transmission in ["manual", "automatic", "cvt", "dct", "amt"]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.vehicleRelationship in ["owner", "broker", "authorized_representative"]
        && request.resource.data.authorizationConfirmed == true
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.images.size() <= 20
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.sellerWhatsApp is string
        && request.resource.data.sellerWhatsApp.size() >= 10
        && request.resource.data.sellerWhatsApp.size() <= 15
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() >= 2
        && request.resource.data.sellerName.size() <= 80
        && request.resource.data.listingStatus in ["pending_payment", "draft"]
        && request.resource.data.paymentStatus in ["pending", "not_due"]
        && request.resource.data.listingFee is number
        && request.resource.data.listingFee >= 0;

      // Anyone can read active listings
      allow read: if true;

      // Sellers can update their own listings (not sold/suspended)
      allow update: if isActiveSeller(request.auth.uid)
        && resource.data.addedBy == request.auth.uid
        && (
          !('listingStatus' in resource.data)
          || resource.data.listingStatus != "sold"
          && resource.data.listingStatus != "suspended"
        )
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'manufacturer', 'carType', 'model', 'year', 'price',
            'status', 'mileage', 'fuel', 'transmission', 'description',
            'vehicleRelationship', 'authorizationConfirmed',
            'images', 'imageUrl',
            'listingStatus', 'paymentStatus', 'listingFee',
            'updatedAt'
          ])
        && request.resource.data.manufacturer is string
        && request.resource.data.manufacturer.size() >= 1
        && request.resource.data.manufacturer.size() <= 50
        && request.resource.data.carType in ["sedan", "suv", "hatchback", "coupe", "convertible", "wagon", "pickup", "van", "minivan", "other"]
        && request.resource.data.model is string
        && request.resource.data.model.size() >= 1
        && request.resource.data.model.size() <= 50
        && request.resource.data.year is int
        && request.resource.data.year >= 1990
        && request.resource.data.year <= 2030
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.status in ["Fresh Import", "Locally Used", "Brand New"]
        && (
          request.resource.data.mileage == null
          || (
            request.resource.data.mileage is int
            && request.resource.data.mileage >= 0
          )
        )
        && request.resource.data.fuel in ["petrol", "diesel", "hybrid", "electric", "plug_in_hybrid", "cng", "lpg"]
        && request.resource.data.transmission in ["manual", "automatic", "cvt", "dct", "amt"]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.vehicleRelationship in ["owner", "broker", "authorized_representative"]
        && request.resource.data.authorizationConfirmed == true
        && request.resource.data.images is list
        && request.resource.data.images.size() >= 1
        && request.resource.data.images.size() <= 20
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.listingFee is number
        && request.resource.data.listingFee >= 0;

      // Sellers can delete their own listings
      allow delete: if isActiveSeller(request.auth.uid)
        && resource.data.addedBy == request.auth.uid
        && (
          !('listingStatus' in resource.data)
          || resource.data.listingStatus != "sold"
        );
    }

    match /dealerDrafts/{draftId} {
      // Pending dealers can create drafts
      allow create: if isPendingDealer(request.auth.uid)
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && request.resource.data.listingStatus == "draft"
        && request.resource.data.paymentStatus == "not_due";

      // Pending dealers can read their own drafts
      allow read: if isPendingDealer(request.auth.uid)
        && resource.data.addedBy == request.auth.uid;

      // Pending dealers can update their own drafts
      allow update: if isPendingDealer(request.auth.uid)
        && resource.data.addedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'manufacturer', 'carType', 'model', 'year', 'price',
            'status', 'mileage', 'fuel', 'transmission', 'description',
            'vehicleRelationship', 'authorizationConfirmed',
            'images', 'imageUrl',
            'listingStatus', 'paymentStatus', 'listingFee',
            'updatedAt'
          ])
        && request.resource.data.listingStatus == "draft";

      // Pending dealers can delete their own drafts
      allow delete: if isPendingDealer(request.auth.uid)
        && resource.data.addedBy == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && isActiveParticipant(request.auth.uid)
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      allow create: if signedIn()
        && isActiveBuyer(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'buyerId', 'buyerName', 'sellerId', 'sellerName',
          'carId', 'carTitle', 'createdAt', 'lastMessageAt', 'lastMessage'
        ])
        && request.resource.data.keys().hasAll([
          'buyerId', 'buyerName', 'sellerId', 'sellerName',
          'carId', 'carTitle', 'createdAt', 'lastMessageAt', 'lastMessage'
        ])
        && request.resource.data.buyerId == request.auth.uid
        && isActiveBuyer(request.auth.uid)
        && request.resource.data.sellerId is string
        && request.resource.data.carId is string
        && exists(/databases/$(database)/documents/cars/$(request.resource.data.carId))
        && get(
          /databases/$(database)/documents/cars/$(request.resource.data.carId)
        ).data.addedBy == request.resource.data.sellerId
        && (
          !('listingStatus' in get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data)
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingStatus == "active"
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingStatus == "sold"
        )
        && (
          !('listingStatus' in get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data)
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingStatus != "sold"
        )
        && isActiveSeller(request.resource.data.sellerId)
        && request.resource.data.buyerName is string
        && request.resource.data.sellerName is string
        && request.resource.data.carTitle is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessage is string;

      allow update: if signedIn()
        && isActiveParticipant(request.auth.uid)
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        )
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 160
        && request.resource.data.lastMessageAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && isActiveParticipant(request.auth.uid)
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
          );

        allow create: if signedIn()
          && isActiveParticipant(request.auth.uid)
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
          )
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
