rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && ownerProfileIsActive();
    }

    function ownerProfileIsActive() {
      let profile = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return profile.active == true && profile.role == "owner";
    }

    function hasSellerProfile(userId) {
      return exists(/databases/$(database)/documents/admins/$(userId));
    }

    function isActiveSeller(userId) {
      return hasSellerProfile(userId) && activeSellerProfile(userId);
    }

    function activeSellerProfile(userId) {
      let profile = get(/databases/$(database)/documents/admins/$(userId)).data;
      return profile.active == true
        && (
          profile.role == "admin"
          || profile.role == "owner"
          || (profile.role == "dealer" && profile.approvalStatus == "approved")
        );
    }

    function isActiveBuyer(userId) {
      return exists(/databases/$(database)/documents/buyers/$(userId))
        && activeBuyerProfile(userId);
    }

    function activeBuyerProfile(userId) {
      let profile = get(/databases/$(database)/documents/buyers/$(userId)).data;
      return !('active' in profile) || profile.active == true;
    }

    function isActiveParticipant(userId) {
      return isActiveBuyer(userId) || isActiveSeller(userId);
    }

    function isPendingDealer(userId) {
      return hasSellerProfile(userId) && pendingDealerProfile(userId);
    }

    function pendingDealerProfile(userId) {
      let profile = get(/databases/$(database)/documents/admins/$(userId)).data;
      return profile.role == "dealer"
        && profile.active == false
        && profile.approvalStatus == "pending";
    }

    function hasActiveFreeListingWindow(userId) {
      let profile = getAfter(/databases/$(database)/documents/admins/$(userId)).data;
      return profile.role == "dealer"
        && profile.approvalStatus == "approved"
        && profile.freeListingWindowStartedAt is timestamp
        && profile.freeListingWindowEndsAt is timestamp
        && profile.freeListingWindowEndsAt > request.time;
    }

    function matchesPendingListingPayment(paymentId, carId, sellerId, amount) {
      let payment = getAfter(/databases/$(database)/documents/listingPayments/$(paymentId)).data;
      return payment.listingId == carId
        && payment.sellerId == sellerId
        && payment.amount == amount;
    }


    function validVehicleFields(data) {
      let mileageValid = data.mileage == null
        || (data.mileage is int && data.mileage >= 0);
      return data.manufacturer is string
        && data.manufacturer.size() >= 1
        && data.manufacturer.size() <= 50
        && data.carType in ["sedan", "suv", "hatchback", "coupe", "convertible", "wagon", "pickup", "van", "minivan", "other"]
        && data.model is string
        && data.model.size() >= 1
        && data.model.size() <= 50
        && data.year is int
        && data.year >= 1990
        && data.year <= 2030
        && data.price is number
        && data.price > 0
        && data.status in ["Fresh Import", "Locally Used", "Brand New"]
        && mileageValid
        && data.fuel in ["petrol", "diesel", "hybrid", "electric", "plug_in_hybrid", "cng", "lpg"]
        && data.transmission in ["manual", "automatic", "cvt", "dct", "amt"]
        && data.description is string
        && data.description.size() <= 5000
        && data.vehicleRelationship in ["owner", "broker", "authorized_representative"]
        && data.authorizationConfirmed == true;
    }

    function validCarCreateFields(data) {
      return data.keys().hasOnly([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt', 'listingExpiresAt', 'freeTrialApprovedAt', 'paymentId'
        ])
        && data.keys().hasAll([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && validVehicleFields(data)
        && data.images is list
        && data.images.size() >= 1
        && data.images.size() <= 20
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.sellerWhatsApp is string
        && data.sellerWhatsApp.size() >= 10
        && data.sellerWhatsApp.size() <= 15
        && data.sellerName is string
        && data.sellerName.size() >= 2
        && data.sellerName.size() <= 80
        && data.createdAt == request.time;
    }

    function validFreeListingCreate(data, userId) {
      return data.listingStatus == "active"
        && data.paymentStatus == "free_trial"
        && data.listingFee == 0
        && data.listingExpiresAt is timestamp
        && data.listingExpiresAt > request.time
        && data.freeTrialApprovedAt == request.time
        && data.listingExpiresAt <= request.time + duration.value(75, 'd')
        && hasActiveFreeListingWindow(userId)
        && !('paymentId' in data);
    }

    function validPaidListingCreate(data, carId, userId) {
      return data.listingStatus == "pending_payment"
        && data.paymentStatus == "pending"
        && data.listingFee is number
        && data.listingFee > 0
        && data.paymentId is string
        && existsAfter(/databases/$(database)/documents/listingPayments/$(data.paymentId))
        && matchesPendingListingPayment(data.paymentId, carId, userId, data.listingFee)
        && !('listingExpiresAt' in data)
        && !('freeTrialApprovedAt' in data);
    }

    function isClosedListing(data) {
      return ('listingStatus' in data)
        && (data.listingStatus == "sold" || data.listingStatus == "suspended");
    }

    function validOwnerFreeActivation(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'listingStatus', 'paymentStatus', 'listingFee',
          'listingExpiresAt', 'freeTrialApprovedAt', 'paymentVerifiedBy'
        ])
        && data.listingStatus == "active"
        && data.paymentStatus == "free_trial"
        && data.listingFee == 0
        && data.listingExpiresAt is timestamp
        && data.listingExpiresAt > request.time
        && data.listingExpiresAt <= request.time + duration.value(75, 'd')
        && data.freeTrialApprovedAt == request.time
        && data.paymentVerifiedBy == request.auth.uid;
    }

    function hasVerifiedLinkedPayment(data, carId, sellerId) {
      let paymentExists = data.paymentId is string
        && existsAfter(/databases/$(database)/documents/listingPayments/$(data.paymentId));
      let payment = paymentExists
        ? getAfter(/databases/$(database)/documents/listingPayments/$(data.paymentId)).data
        : {};
      return paymentExists
        && payment.paymentId == data.paymentId
        && payment.listingId == carId
        && payment.sellerId == sellerId
        && payment.status == "verified"
        && payment.amount == data.paymentAmount
        && payment.paymentMethod == data.paymentMethod
        && payment.reference == data.paymentReference
        && payment.verifiedBy == request.auth.uid;
    }

    function validOwnerPaidActivation(data, carId, sellerId) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'listingStatus', 'paymentStatus', 'listingFee',
          'listingExpiresAt', 'paymentReference', 'paymentVerifiedBy',
          'paymentMethod', 'paymentAmount', 'paymentNote',
          'paidAt', 'renewedAt', 'paymentId'
        ])
        && data.listingStatus == "active"
        && data.paymentStatus == "paid"
        && data.listingFee is number
        && data.listingFee >= 0
        && data.listingExpiresAt is timestamp
        && data.listingExpiresAt > request.time
        && data.listingExpiresAt <= request.time + duration.value(75, 'd')
        && data.paymentReference is string
        && data.paymentReference.size() > 0
        && data.paymentReference.size() <= 100
        && data.paymentAmount is number
        && data.paymentAmount > 0
        && data.paymentMethod is string
        && data.paymentVerifiedBy == request.auth.uid
        && data.paidAt == request.time
        && (!('renewedAt' in data) || data.renewedAt == request.time)
        && hasVerifiedLinkedPayment(data, carId, sellerId);
    }

    function validOwnerVehicleEdit(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed', 'updatedAt'
        ])
        && validVehicleFields(data)
        && data.updatedAt == request.time;
    }

    function validSellerVehicleEdit(data) {
      let changed = data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl', 'updatedAt'
        ])
        && validVehicleFields(data)
        && data.images is list
        && data.images.size() >= 1
        && data.images.size() <= 20
        && data.imageUrl is string
        && data.imageUrl.size() > 0
        && data.updatedAt == request.time;
    }

    match /admins/{userId} {
      allow read: if signedIn()
        && (isOwner() || request.auth.uid == userId || isActiveSeller(request.auth.uid));

      // Sellers can create only their own restricted, pending dealer profile.
      allow create: if isOwner()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'name', 'email', 'role', 'active', 'approvalStatus',
            'verificationStatus', 'sellerType', 'businessName',
            'whatsapp', 'createdAt', 'createdBy'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'email', 'role', 'active', 'approvalStatus',
            'verificationStatus', 'sellerType', 'businessName',
            'whatsapp', 'createdAt', 'createdBy'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == "dealer"
          && request.resource.data.active == false
          && request.resource.data.approvalStatus == "pending"
          && request.resource.data.verificationStatus == "pending"
          && request.resource.data.sellerType in ["dealership", "broker"]
          && request.resource.data.businessName is string
          && (request.resource.data.sellerType != "dealership" || request.resource.data.businessName.size() >= 2)
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() >= 10
          && request.resource.data.whatsapp.size() <= 15
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
        );

      // Only the owner can change approval, activity, or verification status.
      // A signed-in seller can update their own name and WhatsApp number.
      allow update: if isOwner()
        || (
          signedIn()
          && request.auth.uid == userId
          && resource.data.role == "dealer"
          && resource.data.active == true
          && resource.data.approvalStatus == "approved"
          && resource.data.freeListingEligible == true
          && !('freeListingWindowStartedAt' in resource.data)
          && !('freeListingWindowEndsAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['freeListingEligible', 'freeListingWindowStartedAt', 'freeListingWindowEndsAt'])
          && request.resource.data.freeListingEligible == false
          && request.resource.data.freeListingWindowStartedAt == request.time
          && request.resource.data.freeListingWindowEndsAt is timestamp
          && request.resource.data.freeListingWindowEndsAt > request.time
          && request.resource.data.freeListingWindowEndsAt <= request.time + duration.value(60, 'd')
        )
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['name', 'whatsapp', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.whatsapp is string
          && request.resource.data.whatsapp.size() >= 10
          && request.resource.data.whatsapp.size() <= 15
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if isOwner()
        || (signedIn() && request.auth.uid == userId);
    }

    match /buyers/{userId} {
      allow read: if signedIn()
        && (isOwner() || request.auth.uid == userId || isActiveSeller(request.auth.uid));

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'role', 'phone', 'active', 'createdAt',
          'authProvider'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'role', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "buyer"
        && (
          !('phone' in request.resource.data)
          || (
            request.resource.data.phone is string
            && request.resource.data.phone.size() >= 10
            && request.resource.data.phone.size() <= 15
          )
        )
        && (
          !('active' in request.resource.data)
          || request.resource.data.active == true
        )
        && (
          !('authProvider' in request.resource.data)
          || request.resource.data.authProvider == "google"
        )
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && (isOwner() || request.auth.uid == userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name', 'phone', 'active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15;

      allow delete: if isOwner()
        || (signedIn() && request.auth.uid == userId);
    }

    match /cars/{carId} {
      // Active sellers can create new vehicle listings using the account's free window or a linked pending payment.
      allow create: if isActiveSeller(request.auth.uid)
        && request.resource.data.addedBy == request.auth.uid
        && validCarCreateFields(request.resource.data)
        && (
          validFreeListingCreate(request.resource.data, request.auth.uid)
          || validPaidListingCreate(request.resource.data, carId, request.auth.uid)
        );

      // Anyone can read active listings
      allow read: if true;

      // Closed listings cannot be edited or reactivated. Owner checks are evaluated once.
      allow update: if !isClosedListing(resource.data)
        && (
          (
            isOwner()
            && (
              validOwnerFreeActivation(request.resource.data)
              || validOwnerPaidActivation(request.resource.data, carId, ('addedBy' in resource.data) ? resource.data.addedBy : '')
              || (
                resource.data.addedBy == request.auth.uid
                && validOwnerVehicleEdit(request.resource.data)
              )
            )
          )
          || (
            isActiveSeller(request.auth.uid)
            && resource.data.addedBy == request.auth.uid
            && validSellerVehicleEdit(request.resource.data)
          )
        );

      // Sellers can delete their own listings
      allow delete: if isActiveSeller(request.auth.uid)
        && resource.data.addedBy == request.auth.uid
        && (
          !('listingStatus' in resource.data)
          || resource.data.listingStatus != "sold"
        );
    }

    match /dealerDrafts/{draftId} {
      // Pending dealers can create drafts
      allow create: if isPendingDealer(request.auth.uid)
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'manufacturer', 'carType', 'model', 'year', 'price',
          'status', 'mileage', 'fuel', 'transmission', 'description',
          'vehicleRelationship', 'authorizationConfirmed',
          'images', 'imageUrl',
          'addedBy', 'sellerWhatsApp', 'sellerName',
          'listingStatus', 'paymentStatus', 'listingFee',
          'createdAt'
        ])
        && request.resource.data.listingStatus == "draft"
        && request.resource.data.paymentStatus == "not_due";

      // Pending dealers can prepare drafts; approved active sellers can retrieve and publish them.
      allow read: if (isPendingDealer(request.auth.uid) || isActiveSeller(request.auth.uid))
        && resource.data.addedBy == request.auth.uid;

      // Owners of drafts may update them while pending or after approval.
      allow update: if (isPendingDealer(request.auth.uid) || isActiveSeller(request.auth.uid))
        && resource.data.addedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'manufacturer', 'carType', 'model', 'year', 'price',
            'status', 'mileage', 'fuel', 'transmission', 'description',
            'vehicleRelationship', 'authorizationConfirmed',
            'images', 'imageUrl',
            'listingStatus', 'paymentStatus', 'listingFee',
            'updatedAt'
          ])
        && request.resource.data.listingStatus == "draft";

      // Draft owners may delete their own drafts before or after seller approval.
      allow delete: if (isPendingDealer(request.auth.uid) || isActiveSeller(request.auth.uid))
        && resource.data.addedBy == request.auth.uid;
    }

    match /listingPayments/{paymentId} {
      // Owners can review every payment; sellers can see only their own records.
      allow read: if isOwner()
        || (signedIn() && resource.data.sellerId == request.auth.uid);

      // A seller's payment request must be created atomically with its hidden vehicle.
      allow create: if isOwner()
        || (
          isActiveSeller(request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'paymentId', 'listingId', 'sellerId', 'amount',
            'status', 'paymentMethod', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'paymentId', 'listingId', 'sellerId', 'amount',
            'status', 'paymentMethod', 'createdAt'
          ])
          && request.resource.data.paymentId == paymentId
          && request.resource.data.listingId is string
          && request.resource.data.listingId.size() > 0
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/cars/$(request.resource.data.listingId))
          && getAfter(/databases/$(database)/documents/cars/$(request.resource.data.listingId)).data.addedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/cars/$(request.resource.data.listingId)).data.paymentId == paymentId
          && getAfter(/databases/$(database)/documents/cars/$(request.resource.data.listingId)).data.listingStatus == "pending_payment"
        );

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'verifiedAt', 'verifiedBy', 'amount', 'paymentMethod', 'reference', 'note'])
        && request.resource.data.status in ["verified", "rejected"]
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time
        && (
          request.resource.data.status == "rejected"
          || (
            resource.data.listingId is string
            && existsAfter(/databases/$(database)/documents/cars/$(resource.data.listingId))
            && getAfter(/databases/$(database)/documents/cars/$(resource.data.listingId)).data.addedBy == resource.data.sellerId
            && getAfter(/databases/$(database)/documents/cars/$(resource.data.listingId)).data.listingStatus == "active"
            && getAfter(/databases/$(database)/documents/cars/$(resource.data.listingId)).data.paymentStatus == "paid"
            && getAfter(/databases/$(database)/documents/cars/$(resource.data.listingId)).data.paymentVerifiedBy == request.auth.uid
          )
        );

      allow delete: if false;
    }

    match /auditLog/{logId} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && isActiveParticipant(request.auth.uid)
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        );

      allow create: if signedIn()
        && isActiveBuyer(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'buyerId', 'buyerName', 'sellerId', 'sellerName',
          'carId', 'carTitle', 'createdAt', 'lastMessageAt', 'lastMessage'
        ])
        && request.resource.data.keys().hasAll([
          'buyerId', 'buyerName', 'sellerId', 'sellerName',
          'carId', 'carTitle', 'createdAt', 'lastMessageAt', 'lastMessage'
        ])
        && request.resource.data.buyerId == request.auth.uid
        && isActiveBuyer(request.auth.uid)
        && request.resource.data.sellerId is string
        && request.resource.data.carId is string
        && exists(/databases/$(database)/documents/cars/$(request.resource.data.carId))
        && get(
          /databases/$(database)/documents/cars/$(request.resource.data.carId)
        ).data.addedBy == request.resource.data.sellerId
        && (
          !('listingStatus' in get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data)
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingStatus == "active"
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingStatus == "sold"
        )
        && (
          !('listingStatus' in get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data)
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingStatus != "sold"
        )
        && (
          !('paymentStatus' in get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data)
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.paymentStatus in ["paid", "free_trial"]
        )
        && (
          !('listingExpiresAt' in get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data)
          || get(
            /databases/$(database)/documents/cars/$(request.resource.data.carId)
          ).data.listingExpiresAt > request.time
        )
        && isActiveSeller(request.resource.data.sellerId)
        && request.resource.data.buyerName is string
        && request.resource.data.sellerName is string
        && request.resource.data.carTitle is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessage is string;

      allow update: if signedIn()
        && isActiveParticipant(request.auth.uid)
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        )
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 160
        && request.resource.data.lastMessageAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && isActiveParticipant(request.auth.uid)
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
          );

        allow create: if signedIn()
          && isActiveParticipant(request.auth.uid)
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerId == request.auth.uid
          )
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
